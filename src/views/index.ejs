<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= noivos %> - Site de Casamento</title>
    <!-- Fontes do Google: Cinzel (estilo serifado elegante) e Great Vibes (estilo manuscrito) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..700&family=Great+Vibes&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <div class="container navbar">
            <div class="logo"><h1><%= noivos %></h1></div>
            <nav>
                <ul>
                    <li><a href="#historia">A História</a></li>
                    <li><a href="#cerimonia">Cerimônia</a></li>
                    <li><a href="#recepcao">Recepção</a></li>
                    <li><a href="#presentes">Lista de Presentes</a></li>
                    <li><a href="#confirmacao" class="btn-nav">Confirmar Presença</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="hero">
        <div class="hero-content">
            <img src="/img/Monograma.PNG" alt="Monograma" class="hero-monogram">
            <h2><%= noivos %></h2>
            <p>28 | 11 | 2026</p>
        </div>
    </section>

    <section class="welcome-msg container">
        <p class="intro-text">Criamos este site para compartilhar com vocês os detalhes da organização do nosso casamento. Estamos muito felizes e contamos com a presença de todos no nosso grande dia! Aqui vocês encontrarão também local da cerimônia e recepção.</p>
    </section>

    <section id="countdown">
        <h2 class="section-title">Contagem Regressiva</h2>
        <div class="countdown-timer" data-date="<%= dataObj %>">
            <div class="time-box"><span id="dias">00</span><small>Dias</small></div>
            <div class="time-box"><span id="horas">00</span><small>Horas</small></div>
            <div class="time-box"><span id="minutos">00</span><small>Minutos</small></div>
            <div class="time-box"><span id="segundos">00</span><small>Segundos</small></div>
        </div>
    </section>

    <section id="historia" class="container">
        <h2 class="section-title">O Casal & Nossa História</h2>
        <div class="historia-content text-center">
            <% if (typeof verso !== 'undefined' && verso) { %>
                <blockquote class="versiculo">
                    <p><em><%= verso %></em></p>
                </blockquote>
            <% } %>
            <p class="historia-texto-completo"><%= historiaTexto %></p>
        </div>
    </section>

        <!-- Seção de Álbum de Fotos por Sessões -->
    <section id="album-sessoes" class="container">
        <h2 class="section-title">Álbum dos Noivos</h2>
        <p class="intro-text">Momentos guardados com carinho, espalhados em capítulos da nossa história.</p>

        <!-- Botões / Abas para alternar entre as sessões -->
        <div class="album-filtros">
            <button class="btn-filtro ativo" onclick="filtrarSessao('todas')">Todas</button>
            <button class="btn-filtro" onclick="filtrarSessao('ensaio')">Ensaio Pré-Casamento</button>
            <button class="btn-filtro" onclick="filtrarSessao('noivado')">O Noivado</button>
            <button class="btn-filtro" onclick="filtrarSessao('viagens')">Nossas Viagens</button>
        </div>

        <!-- Grelha de Fotos Dinâmica -->
    <div class="album-grid">
        <% if (typeof fotos !== 'undefined' && fotos.length > 0) { %>
            <% fotos.forEach(foto => { %>
                <div class="album-item" data-sessao="<%= foto.sessao %>">
                    <img src="<%= foto.src %>" alt="Foto do Álbum" loading="lazy">
                    <div class="album-legenda"><%= foto.legenda %></div>
                </div>
            <% }) %>
        <% } else { %>
            <p>Nenhuma foto encontrada na pasta.</p>
        <% } %>
</div>
    </section>

    <section id="cerimonia" class="container">
        <h2 class="section-title">Cerimônia</h2>
        <div class="local-card center">
            <h3><%= cerimonia.local %></h3>
            <p><%= cerimonia.endereco %> — Às <%= cerimonia.horario %></p>
            <div class="map-container">
                <iframe src="<%= cerimonia.mapaEmbed %>" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
            <a href="https://maps.app.goo.gl/dbNnKbfFqWCEsUIo6?g_st=iw" target="_blank" class="btn">Ver Mapa Ampliado</a>
        </div>
    </section>

    <section id="recepcao" class="container">
        <h2 class="section-title">Recepção</h2>
        <div class="local-card center">
            <h3><%= recepcao.local %></h3>
            <p><%= recepcao.endereco %></p>
            <div class="map-container">
                <iframe src="<%= recepcao.mapaEmbed %>" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
            <a href="https://maps.app.goo.gl/TmWABHVGKs1vYwLV8?g_st=iw" target="_blank" class="btn">Ver Mapa Ampliado</a>
        </div>
    </section>

    <section id="vestimenta" class="container text-center dresscode">
        <h2 class="section-title">Código de Vestimenta</h2>
        <p>Basta orientar ninguém usar branco ou cor muito clara. Contamos com a colaboração de todos!</p>
    </section>

    <section id="presentes" class="container lista-presentes">
        <h2 class="section-title">Lista de Presentes</h2>
        <p class="text-center" style="margin-bottom: 30px; color: #666;">
            Fique à vontade para escolher um item! Ao clicar em <strong>"Ver no Mercado Livre"</strong>, poderá ver o produto e, em seguida, confirmar a escolha para que ele fique indisponível para outros convidados.
        </p>
        <div class="presentes-grid">
            <% presentes.forEach(item => { %>
                <div class="presente-item card-presente <%= item.comprado ? 'indisponivel' : '' %>">
                    <h3><%= item.nome %></h3>
                    
                    <% if (item.comprado) { %>
                        <span class="badge-comprado">Já Escolhido / Comprado 🎁</span>
                    <% } else { %>
                        <a href="<%= item.link %>" target="_blank" class="btn btn-ver-ml">Ver no Mercado Livre</a>
                        
                        <form action="/presentear/<%= item.id %>" method="POST" style="margin-top: 15px;">
                            <button type="submit" class="btn btn-confirmar" onclick="return confirm('Deseja confirmar que vai dar este presente?')">
                                Escolher este Presente
                            </button>
                        </form>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </section>

    <section id="confirmacao">
        <div class="container">
            <h2 class="section-title">Confirme sua Presença</h2>
            <form id="form-confirmacao">
                <input type="text" name="nome" placeholder="Digite seu nome completo para confirmar" required>
                <textarea name="mensagem" placeholder="Deixe uma mensagem carinhosa para os noivos (opcional)" rows="3"></textarea>
                <button type="submit" class="btn">Enviar Confirmação</button>
            </form>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 - Casamento de <%= noivos %>. Feito com muito amor!</p>
    </footer>

    <script src="/js/main.js"></script>
    <script>
      const targetDate = new Date('2025-10-18T16:00:00').getTime();

      function updateCountdown() {
        const now = new Date().getTime();
        const difference = targetDate - now;

        if (difference <= 0) {
          document.getElementById('dias').innerText = '00';
          document.getElementById('horas').innerText = '00';
          document.getElementById('minutos').innerText = '00';
          document.getElementById('segundos').innerText = '00';
          return;
        }

        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((difference % (1000 * 60)) / 1000);

        document.getElementById('dias').innerText = String(days).padStart(2, '0');
        document.getElementById('horas').innerText = String(hours).padStart(2, '0');
        document.getElementById('minutos').innerText = String(minutes).padStart(2, '0');
        document.getElementById('segundos').innerText = String(seconds).padStart(2, '0');
      }

      setInterval(updateCountdown, 1000);
      updateCountdown();
    </script>
</body>
</html>